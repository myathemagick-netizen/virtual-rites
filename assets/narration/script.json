      "file": "shared/78de69b31767da44.mp3",
      "uses": [
        {
          "ritual": "ouranos-chaos-star",
          "field": "say"
        }
      ],
      "dynamic": false
    },
    {
      "id": "8d5f978bbace874a",
      "text": "A golden sphere joins the orbit.",
      "file": "shared/8d5f978bbace874a.mp3",
      "uses": [
        {
          "ritual": "ouranos-chaos-star",
          "field": "describe"
        }
      ],
      "dynamic": false
    },
    {
      "id": "7c0e0f908a77cdfb",
