      "uses": [
        {
          "ritual": "ouranos-chaos-star",
          "field": "say"
        }
      ],
      "dynamic": false
    },
    {
      "id": "ac6c1b1bf4b0af11",
      "text": "A red sphere joins the orbit.",
      "file": "shared/ac6c1b1bf4b0af11.mp3",
      "uses": [
        {
          "ritual": "ouranos-chaos-star",
          "field": "describe"
        }
      ],
      "dynamic": false
    },
    {
      "id": "78de69b31767da44",
