      "file": "shared/90c73ef91be1016e.mp3",
      "uses": [
        {
          "ritual": "ouranos-chaos-star",
          "field": "describe"
        }
      ],
      "dynamic": false
    },
    {
      "id": "07f204184aa36c13",
