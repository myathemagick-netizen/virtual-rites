      "file": "shared/7c0e0f908a77cdfb.mp3",
      "uses": [
        {
          "ritual": "ouranos-chaos-star",
          "field": "say"
        }
      ],
      "dynamic": false
    },
    {
      "id": "9f9a90e6a7900c0d",
      "text": "A green sphere joins the orbit.",
      "file": "shared/9f9a90e6a7900c0d.mp3",
      "uses": [
        {
          "ritual": "ouranos-chaos-star",
          "field": "describe"
        }
      ],
      "dynamic": false
    },
    {
      "id": "f6dde15e48854ee3",
